<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <View
            android:id="@+id/viewIndicator"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="#7BB39C"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvNombreDoctor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="#757575"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewIndicator"
            app:layout_constraintEnd_toStartOf="@id/tvEspecialidad"
            tools:text="Luis Ángel Fernández" />

        <TextView
            android:id="@+id/tvEspecialidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="#F0F4F1"
            android:textColor="#7BB39C"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="CARDIOLOGÍA" />

        <TextView
            android:id="@+id/tvDisponibilidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textColor="#212121"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvNombreDoctor"
            app:layout_constraintStart_toStartOf="@id/tvNombreDoctor"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Lunes a Viernes" />

        <TextView
            android:id="@+id/tvExperiencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:textColor="#009688"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvDisponibilidad"
            app:layout_constraintStart_toStartOf="@id/tvNombreDoctor"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="10 años de experiencia" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>